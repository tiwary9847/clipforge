{
  "name": "ClipForge – Video Editor",
  "short_name": "ClipForge",
  "description": "Hinglish video editor for Shorts, Reels and YouTube – captions, AI assistant, music without copyright. No ads.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1117",
  "theme_color": "#7c5cff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "./",
  "categories": [
    "photo",
    "video",
    "productivity"
  ],
  "lang": "en-IN",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/*",
            "audio/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "New Short / Reel",
      "short_name": "New Short",
      "url": "./?start=shorts",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "New YouTube video",
      "short_name": "New YouTube",
      "url": "./?start=yt",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "AI assistant",
      "short_name": "Ask AI",
      "url": "./?ask=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}